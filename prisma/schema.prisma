// IHospitality CRM — data model. Money is BigInt cents end-to-end (USD).
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}
enum AccountStatus {
  ACTIVE
  INACTIVE
}
enum AccountKind {
  PARENT
  PROPERTY
}
enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}
enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}
enum PaymentStatus {
  PENDING
  POSTED
  VOID
}
enum PaymentProvider {
  STRIPE
  PAYPAL
  CASH
  BANK_TRANSFER
  MANUAL
}
enum InventoryStatus {
  AVAILABLE
  RESERVED
  INSTALLED
  DAMAGED
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  ISSUE
  VOID
  LOGIN
  LOGOUT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String     @db.VarChar(160)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  roles        UserRole[]
  auditEvents  AuditEvent[]
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(500)
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique @db.VarChar(120)
  label String @db.VarChar(160)
  roles RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CustomerAccount {
  id             String        @id @default(uuid()) @db.Uuid
  accountNumber  String        @unique @map("account_number") @db.VarChar(40)
  name           String        @db.VarChar(200)
  kind           AccountKind   @default(PARENT)
  status         AccountStatus @default(ACTIVE)
  parentId       String?       @map("parent_id") @db.Uuid
  email          String?       @db.VarChar(320)
  phone          String?       @db.VarChar(40)
  billingAddress Json?         @map("billing_address")
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  parent         CustomerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       CustomerAccount[] @relation("AccountHierarchy")
  sites          ServiceAddress[]
  workOrders     WorkOrder[]
  invoices       Invoice[]
  @@index([parentId])
  @@index([name])
  @@map("customer_accounts")
}

model ServiceAddress {
  id         String          @id @default(uuid()) @db.Uuid
  accountId  String          @map("account_id") @db.Uuid
  label      String?         @db.VarChar(100)
  line1      String          @db.VarChar(200)
  line2      String?         @db.VarChar(200)
  city       String          @db.VarChar(100)
  region     String?         @db.VarChar(100)
  postal     String?         @db.VarChar(30)
  country    String          @default("US") @db.Char(2)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(6)
  account    CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  workOrders WorkOrder[]
  @@index([accountId])
  @@map("service_addresses")
}

model Technician {
  id           String   @id @default(uuid()) @db.Uuid
  employeeNo   String   @unique @map("employee_no") @db.VarChar(40)
  name         String   @db.VarChar(160)
  email        String?  @unique @db.VarChar(320)
  phone        String?  @db.VarChar(40)
  active       Boolean  @default(true)
  payRateCents BigInt?  @map("pay_rate_cents")
  currency     String   @default("USD") @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  workOrders   WorkOrder[]
  @@map("technicians")
}

model JobType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  active      Boolean  @default(true)
  workOrders  WorkOrder[]
  priceBookItems PriceBookItem[]
  @@map("job_types")
}

model PriceBookItem {
  id             String   @id @default(uuid()) @db.Uuid
  jobTypeId      String   @map("job_type_id") @db.Uuid
  name           String   @db.VarChar(160)
  unitPriceCents BigInt   @map("unit_price_cents")
  currency       String   @default("USD") @db.Char(3)
  taxRateBps     Int      @default(0) @map("tax_rate_bps")
  active         Boolean  @default(true)
  jobType        JobType  @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)
  @@index([jobTypeId])
  @@map("price_book_items")
}

model WorkOrder {
  id               String          @id @default(uuid()) @db.Uuid
  orderNumber      String          @unique @map("order_number") @db.VarChar(40)
  accountId        String          @map("account_id") @db.Uuid
  serviceAddressId String          @map("service_address_id") @db.Uuid
  jobTypeId        String          @map("job_type_id") @db.Uuid
  technicianId     String?         @map("technician_id") @db.Uuid
  status           WorkOrderStatus @default(DRAFT)
  scheduledAt      DateTime?       @map("scheduled_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  summary          String?         @db.VarChar(500)
  completionNotes  String?         @map("completion_notes") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  account          CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  serviceAddress   ServiceAddress  @relation(fields: [serviceAddressId], references: [id], onDelete: Restrict)
  jobType          JobType         @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)
  technician       Technician?     @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  lines            WorkOrderLine[]
  invoices         Invoice[]
  @@index([accountId, status])
  @@index([technicianId, scheduledAt])
  items            WorkOrderItem[]
  @@map("work_orders")
}

model WorkOrderLine {
  id             String   @id @default(uuid()) @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  description    String   @db.VarChar(300)
  quantity       Int      @default(1)
  unitPriceCents BigInt   @map("unit_price_cents")
  taxRateBps     Int      @default(0) @map("tax_rate_bps")
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  @@index([workOrderId])
  @@map("work_order_lines")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(40)
  accountId     String        @map("account_id") @db.Uuid
  workOrderId   String?       @map("work_order_id") @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD") @db.Char(3)
  subtotalCents BigInt        @map("subtotal_cents")
  taxCents      BigInt        @map("tax_cents")
  totalCents    BigInt        @map("total_cents")
  issuedAt      DateTime?     @map("issued_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)
  account       CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  workOrder     WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  lines         InvoiceLine[]
  creditNotes   CreditNote[]
  allocations   PaymentAllocation[]
  checkouts     PaymentCheckout[]
  @@index([accountId, status])
  @@map("invoices")
}

model InvoiceLine {
  id                String   @id @default(uuid()) @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  description       String   @db.VarChar(300)
  quantity          Int
  unitPriceCents    BigInt   @map("unit_price_cents")
  taxRateBps        Int      @map("tax_rate_bps")
  lineSubtotalCents BigInt   @map("line_subtotal_cents")
  lineTaxCents      BigInt   @map("line_tax_cents")
  lineTotalCents    BigInt   @map("line_total_cents")
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  @@index([invoiceId])
  @@map("invoice_lines")
}

model CreditNote {
  id             String           @id @default(uuid()) @db.Uuid
  creditNumber   String           @unique @map("credit_number") @db.VarChar(40)
  invoiceId      String?          @map("invoice_id") @db.Uuid
  status         CreditNoteStatus @default(DRAFT)
  currency       String           @default("USD") @db.Char(3)
  totalCents     BigInt           @map("total_cents")
  reason         String           @db.VarChar(500)
  idempotencyKey String?          @unique @map("idempotency_key") @db.VarChar(120)
  issuedAt       DateTime?        @map("issued_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]
  @@index([invoiceId])
  @@map("credit_notes")
}

model Payment {
  id            String          @id @default(uuid()) @db.Uuid
  paymentNumber String          @unique @map("payment_number") @db.VarChar(40)
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(MANUAL)
  externalId    String?         @unique @map("external_id") @db.VarChar(255)
  currency      String          @default("USD") @db.Char(3)
  amountCents   BigInt          @map("amount_cents")
  receivedAt    DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  method        String          @db.VarChar(60)
  reference     String?         @db.VarChar(120)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)
  allocations   PaymentAllocation[]
  checkout      PaymentCheckout?
  @@map("payments")
}

model PaymentAllocation {
  id           String      @id @default(uuid()) @db.Uuid
  paymentId    String      @map("payment_id") @db.Uuid
  invoiceId    String?     @map("invoice_id") @db.Uuid
  creditNoteId String?     @map("credit_note_id") @db.Uuid
  amountCents  BigInt      @map("amount_cents")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?   @map("deleted_at") @db.Timestamptz(6)
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creditNote   CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// Tracks a hosted-checkout attempt (Stripe/PayPal) until the webhook confirms.
model PaymentCheckout {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  provider    PaymentProvider
  sessionId   String          @unique @map("session_id") @db.VarChar(255)
  amountCents BigInt          @map("amount_cents")
  currency    String          @default("USD") @db.Char(3)
  status      String          @default("CREATED") @db.VarChar(40)
  paymentId   String?         @unique @map("payment_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment     Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([invoiceId])
  @@map("payment_checkouts")
}

// Idempotency ledger for inbound gateway webhooks.
model WebhookEvent {
  id          String          @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String          @map("event_id") @db.VarChar(255)
  type        String          @db.VarChar(120)
  processedAt DateTime        @default(now()) @map("processed_at") @db.Timestamptz(6)
  @@unique([provider, eventId])
  @@map("webhook_events")
}

model InventoryItem {
  id            String          @id @default(uuid()) @db.Uuid
  sku           String          @unique @db.VarChar(80)
  name          String          @db.VarChar(160)
  serialNo      String?         @unique @map("serial_no") @db.VarChar(120)
  status        InventoryStatus @default(AVAILABLE)
  quantity      Int             @default(0)
  unitCostCents BigInt          @map("unit_cost_cents")
  currency      String          @default("USD") @db.Char(3)
  location      String?         @db.VarChar(160)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)
  usedOn        WorkOrderItem[]
  @@map("inventory_items")
}

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  storageKey  String   @unique @map("storage_key") @db.VarChar(500)
  fileName    String   @map("file_name") @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(150)
  sizeBytes   BigInt   @map("size_bytes")
  checksum    String?  @db.VarChar(128)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String   @map("entity_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  @@index([entityType, entityId])
  @@map("documents")
}

model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   String      @map("entity_id") @db.Uuid
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  requestId  String?     @map("request_id") @db.VarChar(100)
  sourceIp   String?     @map("source_ip") @db.Inet
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

model WorkOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  workOrderId     String        @map("work_order_id") @db.Uuid
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  quantity        Int
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  @@index([workOrderId])
  @@map("work_order_items")
}
